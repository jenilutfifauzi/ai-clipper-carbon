# Copy to .env and fill in. Real environment variables override this file;
# an empty value means "use the default".

# The LLM that selects clips: gemini, or openai for an OpenAI-compatible Chat
# Completions API (DeepSeek by default). Each eval report records which one ran,
# so running `make eval` once per provider compares them.
LLM_PROVIDER=gemini

# For LLM_PROVIDER=gemini. API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Narrations (the Advanced Edit's Narrate tab) read by Gemini TTS whenever
# GEMINI_API_KEY is set, whatever LLM_PROVIDER says. Its speech model:
TTS_GEMINI_MODEL=gemini-3.8-flash-lite-tts

# Or an OpenAI-compatible speech service (it calls /audio/speech), offered when
# all three are set; apart from LLM_BASE_URL and LLM_API_KEY. For OpenAI:
# TTS_BASE_URL=https://api.openai.com/v1 and TTS_MODEL=gpt-4o-mini-tts.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
# Its Voices, comma-separated; empty means OpenAI's standard list (alloy, ash,
# ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar).
TTS_VOICES=
# Whether it takes a Style line, sent as its instructions (true/false); empty means
# on for models that take instructions (gpt-4o-mini-tts and its kind), off for others.
TTS_STYLE=

# For LLM_PROVIDER=openai. The API's base URL (the client adds /chat/completions)
# and model; DeepSeek's API key: https://platform.deepseek.com/api_keys
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek only: enabled or disabled. Thinking tokens are billed as output and
# make answers slower; it may or may not choose better clips, so run the eval
# with each setting and compare the reports.
LLM_THINKING=disabled

# Seconds between the starts of two LLM requests. Empty means the provider's
# default: 13 for gemini (the free tier allows 5 requests a minute), 1 for openai.
LLM_REQUEST_INTERVAL_SECS=

# mlx-whisper model (Hugging Face repo id) for per-clip captions and the
# full-episode fallback when YouTube has no captions.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# ffmpeg from Homebrew ffmpeg-full (the standard formula has no libass).
# ffprobe is expected in the same directory.
FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# Where Jobs and their files are stored. Relative paths resolve against the repo root.
DATA_DIR=./data

# Optional: browser yt-dlp reads YouTube cookies from (e.g. chrome, safari, firefox)
# when downloads start failing with 403. Empty means no cookies.
YTDLP_COOKIES_FROM_BROWSER=

# Also send each shortlisted Window's audio to Gemini during selection (true/false).
# Needs LLM_PROVIDER=gemini.
SELECTION_AUDIO_SIGNAL=false
