# Copy to .env and fill in. Real environment variables override this file;
# an empty value means "use the default".

# Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model used for clip selection.
GEMINI_MODEL=gemini-3.8-flash

# mlx-whisper model (Hugging Face repo id) for per-clip captions and the
# full-episode fallback when YouTube has no captions.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# ffmpeg from Homebrew ffmpeg-full (the standard formula has no libass).
# ffprobe is expected in the same directory.
FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# Where Jobs and their files are stored. Relative paths resolve against the repo root.
DATA_DIR=./data

# Optional: browser yt-dlp reads YouTube cookies from (e.g. chrome, safari, firefox)
# when downloads start failing with 403. Empty means no cookies.
YTDLP_COOKIES_FROM_BROWSER=

# Also send each shortlisted Window's audio to Gemini during selection (true/false).
SELECTION_AUDIO_SIGNAL=false
