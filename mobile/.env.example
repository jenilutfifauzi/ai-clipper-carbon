# Public Clerk publishable key for native authentication. Never put a Clerk secret key here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# HTTPS origin of the FastAPI server. Do not add /api; the mobile client appends it.
# Plain http:// is accepted only in a development build. Leave both values unset to build an app
# that offers only the on-device Local Render.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
