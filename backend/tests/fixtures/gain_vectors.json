        [3.75, 0.8], [4, 0.8], [5, 0.4], [5.5, 0.2], [6, 0], [6.1, 0]
      ]
    },
    {
      "name": "keyed, Linear then eased in-out",
      "sound": {
        "start": 2,
        "end": 8,
        "volume": 0.5,
        "keys": [
          {"at": 1, "value": 0.2},
          {"at": 3, "value": 1.0, "ease": [0, 0, 1, 1]},
          {"at": 5, "value": 0.2, "ease": [0.42, 0, 0.58, 1]}
        ]
      },
      "at": [
        [1.9, 0], [2, 0.2], [3, 0.2], [4, 0.6], [5, 1.0], [5.5, 0.8966704551624],
